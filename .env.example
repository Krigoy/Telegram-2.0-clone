# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Convex — written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Stream (Chat + Video) — https://dashboard.getstream.io → your app
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET_KEY=your_stream_api_secret

# Note: CLERK_JWT_ISSUER_DOMAIN is set in the Convex dashboard
# (Settings → Environment Variables), not in this file.
